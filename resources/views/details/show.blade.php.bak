        }

        .detail-grid {
            gap: 16px;
        }

        .characteristics-grid {
            grid-template-columns: 1fr;
        }

        .card {
            padding: 16px;
        }

        .detail-table thead,
        .components-table thead {
            display: none;
        }

        .detail-table tbody,
        .components-table tbody,
        .detail-table tr,
        .components-table tr,
        .detail-table td,
        .components-table td {
            display: block;
            width: 100%;
        }

        .detail-table tr,
        .components-table tr {
            margin-bottom: 16px;
            border: 1px solid #e5e7eb;
            border-radius: 8px;
            overflow: hidden;
        }

        .detail-table td::before,
        .components-table td::before {
            content: attr(data-label);
            font-weight: bold;
            display: block;
            margin-bottom: 4px;
        }
    }
</style>
@endsection
